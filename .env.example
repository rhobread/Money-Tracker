# Public OAuth client IDs, not secrets. Create them in the same Google Cloud project.
# Android needs a Web application client ID here, plus an Android client registered
# with package com.moneytracker.app and the actual APK signing certificate SHA-1.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# Optional for Android; required only when enabling Google sign-in on iOS.
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
